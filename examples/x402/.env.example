# Hedera Network & Operator Configuration
NEXT_PUBLIC_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.xxxx
HEDERA_OPERATOR_KEY=3030... # ECDSA private key on testnet

# x402 Micropayment Settings
X402_RECEIVER_ACCOUNT_ID=0.0.yyyy # Merchant / Server receiver account
X402_FACILITATOR_URL=https://x402.org/facilitator # or local / custom facilitator
X402_DEFAULT_ASSET=0.0.0 # 0.0.0 for HBAR tinybars, or 0.0.429274 for Testnet USDC
X402_FEE_PAYER_ID=0.0.xxxx
X402_FEE_PAYER_KEY=3030...

# WalletConnect (Client safe)
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id

# Optional Pre-configured HCS Topic for x402 gated messages
HCS_TOPIC_ID=0.0.zzzz
